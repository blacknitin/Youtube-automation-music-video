# SongForge active configuration — OpenMontage is THE video generator (strict)
VIDEO_PROVIDER=openmontage
OPENMONTAGE_REPO=/home/user/songforge/vendor/OpenMontageCPU
OPENMONTAGE_ENGINE=ltx2-local
# On a GPU machine point OPENMONTAGE_REPO at the real clone instead:
#   OPENMONTAGE_REPO=/path/to/OpenMontage        (LTX-2 / Wan / Hunyuan / CogVideoX)
AUTO_APPROVE_LYRICS=1
