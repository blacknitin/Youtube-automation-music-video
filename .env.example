# ============================================================================
# SongForge — local-first AI music-video studio
# Copy to `.env` and adjust. Everything works with ZERO changes (offline
# mock LLM + placeholder art + estimated sync). Add providers when ready.
# ============================================================================

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Data folder (SQLite DB + all media). Default: backend/data
# DATA_DIR=/home/you/songforge-data
# PostgreSQL alternative to SQLite:
# DATABASE_URL=postgresql+psycopg://songforge:songforge@localhost:5432/songforge

# --- AI providers ------------------------------------------------------------
# "auto" = use the real local provider when it is reachable, else fall back.
# Explicit choices:  LLM_PROVIDER: ollama | free | openai | mock
#                    IMAGE_PROVIDER: openmontage | comfyui | placeholder
#                    ALIGNER: whisperx | estimate
#                    ASR_PROVIDER: faster-whisper | mock  (lyrics extraction)
LLM_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1            # any model you pulled, e.g. qwen2.5, gemma2
LLM_TEMPERATURE=0.9

# Local HuggingFace Transformers (free, offline — see requirements-ai.txt)
# NLP_AUTO=1                      # auto-enable sentiment/summary NLP when transformers is installed
# NLP_ENABLED=1                   # force-enable the local NLP enrichment
# HF_LLM_MODEL=EleutherAI/gpt-neo-125M
# LLM_PROVIDER=hf                 # force the offline gpt-neo writer (auto prefers ollama/Gemini)

# Free AI (recommended for zero-cost real AI prompt writing) — pick ONE preset
# and paste its free key. Chain: ollama -> free -> mock, so this is used when
# Ollama isn't running.
#   FREE_LLM_PRESET=groq        free key: https://console.groq.com/keys
#   FREE_LLM_PRESET=gemini      free key: https://aistudio.google.com/apikey
#   FREE_LLM_PRESET=openrouter  free key: https://openrouter.ai/keys  (`:free` models)
#   FREE_LLM_PRESET=custom    + FREE_LLM_BASE_URL / FREE_LLM_MODEL (any compat endpoint)
# FREE_LLM_PRESET=groq
# FREE_LLM_API_KEY=
# FREE_LLM_MODEL=                # optional override of the preset's default model

# Cloud LLM (optional) — works with OpenAI, Groq, OpenRouter, Together, vLLM…
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

IMAGE_PROVIDER=auto   # scene art: openmontage (with OPENMONTAGE_REPO) | comfyui | placeholder
COMFY_URL=http://localhost:8188
# Optional exported ComfyUI workflow (API format). Include the literal tokens
# __PROMPT__, __NEGATIVE__, __SEED__, __WIDTH__, __HEIGHT__ inside it.
# COMFY_WORKFLOW=C:\comfy\workflows\songforge_sdxl.json
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720

ALIGNER=auto
WHISPERX_MODEL=small             # tiny|base|small|medium|large-v3 (downloaded on first run)

# Lyrics extraction (transcribe the song's vocals). "auto" uses faster-whisper
# when installed (pip install -r requirements-asr.txt), else a demo extractor.
ASR_PROVIDER=auto
ASR_MODEL=base                   # tiny|base|small… (multilingual; downloaded on first run)

# AI video generation - animate each scene image with free open-source models
# (SVD / AnimateDiff / Wan / LTX-Video) via ComfyUI. "auto" uses ComfyUI when
# it is reachable AND a workflow is configured; otherwise FFmpeg Ken-Burns.
# Extracted lyrics are approved automatically (edit + re-approve anytime)
AUTO_APPROVE_LYRICS=1
VIDEO_PROVIDER=auto
# API-format workflow with __IMAGE__/__PROMPT__/__SEED__/__FRAMES__/__FPS__/
# __WIDTH__/__HEIGHT__ tokens - see examples/comfyui_video_workflow_svd.json
# COMFY_VIDEO_WORKFLOW=C:\comfy\workflows\svd_songforge.json

# Character animation - rig the character in a scene image and apply real
# motion clips (dance / jump / wave / ...) using Meta's AnimatedDrawings (MIT).
#   git clone https://github.com/facebookresearch/AnimatedDrawings
#   pip install -e AnimatedDrawings
# Needs a machine with a display/OpenGL for its renderer. Scenes without a
# detectable character fall back to FFmpeg motion automatically.
# CHAR_ANIM_REPO=/path/to/AnimatedDrawings

# Diffusers video models - MORE free GitHub repos, one engine (needs GPU/big RAM;
# models download once): svd | animatediff | ltx | cogvideox | wan
#   pip install diffusers torch transformers accelerate imageio imageio-ffmpeg
# VIDEO_DIFFUSERS_MODEL=ltx
# VIDEO_DIFFUSERS_PYTHON=/path/to/python_with_diffusers
# VIDEO_DIFFUSERS_STEPS=25
# VIDEO_DIFFUSERS_GUIDANCE=3.5
# CHAR_ANIM_PYTHON=/path/to/python_with_animateddrawings

# OpenMontage (github.com/calesthio/OpenMontage, AGPLv3) - agentic open-source
# video studio: LTX-2 local, Wan 2.1/2.2, HunyuanVideo, CogVideoX engines.
#   git clone https://github.com/calesthio/OpenMontage
# OPENMONTAGE_REPO=/path/to/OpenMontage
# OPENMONTAGE_ENGINE=ltx2-local     # wan2.2-i2v-a14b | wan2.1-1.3b | hunyuan-1.5 | cogvideo-2b | cogvideo-5b
# OPENMONTAGE_PYTHON=/path/to/python_with_diffusers
# VIDEO_PROVIDER=openmontage        # or auto

# --- video rendering ----------------------------------------------------------
# FFMPEG_BIN=ffmpeg              # full path if ffmpeg is not on PATH
# FFPROBE_BIN=ffprobe
RENDER_PRESET=veryfast           # ffmpeg x264 preset
RENDER_CRF=20                    # quality (lower = better/bigger)
SUBTITLE_FONT=Noto Sans Devanagari
# FONTS_DIR=                     # extra fonts folder (Noto fonts bundled in backend/fonts)

# --- YouTube upload (optional; never uploads without your explicit click) -----
# Create OAuth credentials at https://console.cloud.google.com :
#   1. New project -> enable "YouTube Data API v3"
#   2. OAuth consent screen (External, add yourself as test user)
#   3. Credentials -> Create OAuth client ID -> Desktop app
#   4. Put the client ID/secret here
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must match a "Authorized redirect URI" on your OAuth client:
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
